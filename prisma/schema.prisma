// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  familyName    String?
  givenName     String?
  fullName      String?
  phone1        String?
  phone2        String?
  birthday      DateTime?
  profession    String?
  email         String        @unique
  role          String        @default("USER")
  appointments  Appointment[]
  staffProfile  Staff?
  createdSalons Salon[]       @relation("SalonCreators")
  suggestions   Suggestion[]
}

model Suggestion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Salon {
  id       String    @id @default(cuid())
  name     String    @unique
  services Service[]
  staff    Staff[]
  createdById String
  createdBy   User    @relation("SalonCreators", fields: [createdById], references: [id])
}

model Staff {
  id           String        @id @default(cuid())
  name         String
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id])
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model Service {
  id           String        @id @default(cuid())
  name         String
  category     String?
  description  String?
  price        Float
  duration     Int           // Duration in minutes
  imgUrl       String?
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  staffId         String?
  staff           Staff?   @relation(fields: [staffId], references: [id])
  appointmentDate String
  startTime       String
  endTime         String
  postNumber      Int      // Number of the workstation (1 to 4)
  status          String   @default("PENDING") // PENDING, CONFIRMED, REJECTED, CANCELLED
  rejectionNote   String?
  notes           String?
  imageUrl        String?
  
  @@unique([postNumber, appointmentDate, startTime])
}

